# Copy this file to .env and fill in your own keys.
# NEVER commit .env or share it.

ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# iex = free real-time IEX feed
# sip = consolidated US exchanges (requires suitable Alpaca market-data plan)
# delayed_sip = delayed consolidated feed if supported by your plan
ALPACA_FEED=iex

# The day scanner uses Alpaca whole-market Movers/Most Active when SIP screener access is available.
